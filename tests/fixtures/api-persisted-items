#!/usr/bin/env python3
from contextlib import ExitStack, closing
import errno
import json
from pathlib import Path
import runpy
import sqlite3
import tempfile
import threading
from http.client import HTTPConnection


def post(port, name):
    body = json.dumps({'name': name})
    with closing(HTTPConnection('localhost', port, timeout=5)) as client:
        client.request('POST', '/items', body, {'Content-Type': 'application/json'})
        response = client.getresponse()
        reply = response.read().decode('utf-8', errors='replace')
    print(f'POST /items {body} -> HTTP {response.status} {reply}')
    return response.status, reply


def read_back(database, stage):
    with closing(sqlite3.connect(database.as_uri() + '?mode=ro', uri=True)) as store:
        names = [name for (name,) in store.execute('SELECT name FROM items ORDER BY name')]
    print(f'SQLite {stage}: {json.dumps(names)}')
    return names


def main():
    create_server = runpy.run_path('service.py')['create_server']
    with ExitStack() as cleanup:
        try:
            folder = cleanup.enter_context(tempfile.TemporaryDirectory(prefix='items-api-'))
            database = Path(folder).resolve() / 'items.sqlite'
        except OSError as error:
            print(f'cannot provision: {error}')
            return 125
        try:
            server = cleanup.enter_context(create_server(database))
        except OSError as error:
            if error.errno not in (errno.EACCES, errno.EADDRINUSE, errno.EADDRNOTAVAIL):
                raise
            print(f'cannot provision: {error}')
            return 125
        except sqlite3.OperationalError as error:
            if error.sqlite_errorcode != sqlite3.SQLITE_CANTOPEN:
                raise
            print(f'cannot provision: {error}')
            return 125

        worker = threading.Thread(target=server.serve_forever, daemon=True)
        worker.start()
        try:
            before = read_back(database, 'before POST')
            accepted = post(server.server_port, 'demo')
            after_create = read_back(database, 'after create')
            rejected = post(server.server_port, '')
            after_error = read_back(database, 'after error')
        finally:
            server.shutdown()
            worker.join()

    return int(before != [] or accepted != (201, 'created') or after_create != ['demo']
               or rejected != (422, 'name required') or after_error != after_create)


if __name__ == '__main__':
    raise SystemExit(main())
