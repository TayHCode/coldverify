#!/usr/bin/env node

const { readFileSync, writeFileSync } = require('node:fs');
const { join } = require('node:path');

async function chrome(endpoint, path, method = 'GET') {
    const response = await fetch(new URL(path, endpoint), { method, signal: AbortSignal.timeout(5000) });
    if (!response.ok) throw new Error(`Chrome returned HTTP ${response.status} for ${path}`);
    return response;
}

function waitFor(socket, event, select) {
    return new Promise((resolve, reject) => {
        const timer = setTimeout(() => finish(reject, new Error(`CDP ${event} timed out`)), 5000);
        function finish(settle, value) {
            clearTimeout(timer);
            socket.removeEventListener(event, receive);
            socket.removeEventListener('error', failed);
            socket.removeEventListener('close', failed);
            settle(value);
        }
        function receive(message) {
            try {
                const value = select(message);
                if (value !== undefined) finish(resolve, value);
            } catch (error) {
                finish(reject, error);
            }
        }
        function failed() {
            finish(reject, new Error('CDP connection closed or failed'));
        }
        socket.addEventListener(event, receive);
        socket.addEventListener('error', failed);
        socket.addEventListener('close', failed);
    });
}

async function observe(socket, html, screenshot) {
    await waitFor(socket, 'open', () => true);
    let id = 0;
    async function send(method, params = {}) {
        const request = ++id;
        socket.send(JSON.stringify({ id: request, method, params }));
        const reply = await waitFor(socket, 'message', event => {
            const message = JSON.parse(event.data);
            return message.id === request ? message : undefined;
        });
        if (reply.error) throw new Error(`${method}: ${reply.error.message}`);
        return reply.result;
    }

    await send('Emulation.setDeviceMetricsOverride', { width: 560, height: 240, deviceScaleFactor: 1, mobile: false });
    const { frameTree } = await send('Page.getFrameTree');
    await send('Page.setDocumentContent', { frameId: frameTree.frame.id, html });
    const state = await send('Runtime.evaluate', { returnByValue: true, expression: `(() => {
        const button = document.querySelector('button');
        const bounds = button.getBoundingClientRect();
        return { label: button.textContent, total: document.querySelector('#total').textContent,
                 x: bounds.left + bounds.width / 2, y: bounds.top + bounds.height / 2 };
    })()` });
    const { label, total, x, y } = state.result.value ?? {};
    if (label !== 'Apply $2 discount' || total !== 'Total: $20.00') throw new Error('Cart did not start at $20.00');
    for (const type of ['mousePressed', 'mouseReleased']) {
        await send('Input.dispatchMouseEvent', { type, x, y, button: 'left', clickCount: 1 });
    }
    const after = await send('Runtime.evaluate', { expression: "document.querySelector('#total').textContent" });
    const observed = after.result.value;
    if (!['Total: $19.00', 'Total: $18.00'].includes(observed)) throw new Error(`Unexpected cart state: ${observed}`);
    const { data } = await send('Page.captureScreenshot', { format: 'png' });
    writeFileSync(screenshot, Buffer.from(data, 'base64'));
    return observed;
}

async function main() {
    const endpoint = process.env.CDP_ENDPOINT;
    if (!endpoint) throw new Error('Set CDP_ENDPOINT to a running Chrome browser');
    const screenshot = join(process.env.COLD_FLOW_ARTIFACTS, 'discount.png');
    const html = readFileSync('cart.html', 'utf8');
    const tab = await (await chrome(endpoint, '/json/new?about:blank', 'PUT')).json();
    let socket;
    let observed;
    try {
        socket = new WebSocket(tab.webSocketDebuggerUrl);
        observed = await observe(socket, html, screenshot);
    } finally {
        socket?.close();
        await chrome(endpoint, `/json/close/${tab.id}`);
    }
    console.log(`After clicking Apply $2 discount, expected Total: $18.00. Observed ${observed}.`);
    return observed === 'Total: $18.00' ? 0 : 1;
}

main().then(code => { process.exitCode = code; }).catch(error => {
    console.error(`cannot provision or observe the browser flow: ${error.message}`);
    process.exitCode = 125;
});
