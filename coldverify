#!/usr/bin/env python3
import argparse
import fcntl
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
from urllib.parse import urlsplit

ROOT = Path(__file__).resolve().parent
PYTHON_FLOOR = (3, 12)
PUBLISH_TOKENS = ('GH_TOKEN', 'GITHUB_TOKEN')
HOST = re.compile(r'[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?(?::[0-9]{1,5})?')
COMMIT = re.compile(r'[0-9a-f]{40}|[0-9a-f]{64}')
EXPLICIT = ('base', 'head', 'test_command')
EXPLICIT_CONFLICTS = ('compat', 'deployed', 'cache', 'publish_check', 'no_repro_reason', 'require_receipt', 'history',
                      'criteria_check', 'preview')
GIT_LOCATION = ('GIT_DIR', 'GIT_WORK_TREE', 'GIT_INDEX_FILE', 'GIT_COMMON_DIR',
                'GIT_OBJECT_DIRECTORY', 'GIT_ALTERNATE_OBJECT_DIRECTORIES')


def verifier():
    import tomllib
    number = tomllib.loads((ROOT / 'pyproject.toml').read_text(encoding='utf-8'))['project']['version']
    stamp = ROOT / 'COMMIT'
    stamped = stamp.read_text(encoding='utf-8').strip() if stamp.is_file() else '$Format'
    if not stamped.startswith('$Format'):
        return {'version': number, 'commit': stamped or None}
    env = {key: value for key, value in os.environ.items() if key not in GIT_LOCATION}
    found = subprocess.run(['git', '-C', str(ROOT), 'describe', '--always', '--dirty', '--abbrev=12'],
                           text=True, capture_output=True, env=env)
    return {'version': number, 'commit': found.stdout.strip() if found.returncode == 0 else None}


def version():
    found = verifier()
    return f"coldverify {found['version']} ({found['commit'] or 'unknown commit'})"


def deployed_target(text):
    url = urlsplit(text) if text.isprintable() and ' ' not in text else None
    if HOST.fullmatch(text) or url and url.scheme in ('http', 'https') and url.hostname and not url.username and not url.password:
        return text
    raise argparse.ArgumentTypeError(f'{text!r} is not an http(s) URL or a host name; '
                                     'pass credentials through the flow\'s environment, never in the target')


def commit_sha(text):
    if COMMIT.fullmatch(text):
        return text
    raise argparse.ArgumentTypeError(f'{text!r} is not a full lowercase commit SHA')


def explicit_error(args):
    given = [name for name in EXPLICIT if getattr(args, name) is not None]
    if not given:
        return '--install-command needs --base, --head and --test-command' if args.install_command is not None else None
    if len(given) < len(EXPLICIT):
        return '--base, --head and --test-command go together'
    if not args.test_command.strip():
        return '--test-command cannot be empty'
    if args.install_command is not None and not args.install_command.strip():
        return '--install-command cannot be empty'
    conflicts = ['--' + name.replace('_', '-') for name in EXPLICIT_CONFLICTS if getattr(args, name)]
    if conflicts:
        return '--test-command cannot be combined with ' + ', '.join(conflicts)
    return None


def parser():
    verify = argparse.ArgumentParser(prog='coldverify', description='Run a repository\'s verify recipe and report PASS only with fresh proof')
    verify.add_argument('--version', action='store_true', help='Print the version and commit, then exit')
    verify.add_argument('--claim', help='What the change claims to do; defaults to the "## Claim" section of the PR description')
    verify.add_argument('--builder-model', action='append', default=[],
                        help='A model that built the change; repeat for each. The acceptance-criteria verifier excludes them. A PR\'s "Builder-Model: MODEL" lines must name the same models')
    verify.add_argument('--no-repro-reason', help='Record why no repro test is possible; the run is then INCOMPLETE, never PASS')
    verify.add_argument('--ci', action='store_true', help='Run ordinary CI without the interactive verification-skill prerequisite; in a GitHub Actions job a strict --ci run '
                        'without --publish-check is the merge gate: it exits 1 only for failing tests or flows, a secret or lesson-check '
                        'finding, or a bug fix without a working repro, and 0 otherwise')
    verify.add_argument('--compat', action='store_true',
                        help="Give ColdStack's verify gate's verdicts: a repro only for bug fixes, no claim or receipt, and the recipe's exit code")
    verify.add_argument('--bug-fix', action='store_true', help='Treat the change as a bug fix even without a bug-fix title, branch or body: --compat and merge-gate runs then fail without a working repro')
    verify.add_argument('--no-cache', action='store_true', help='Never reuse steps; strict runs reuse steps only with --cache, --compat runs by default')
    verify.add_argument('--cache', action='store_true',
                        help='Strict: for a normal-risk change, reuse the test run of a trusted PASS receipt whose tree, recipe and '
                             'environment hashes all match; otherwise reuse cached steps, which makes the run INCOMPLETE')
    verify.add_argument('--gate', action='store_true', help='Release or merge-gate run: reuse a cached step only for the exact same tree')
    verify.add_argument('--publish-check', action='store_true',
                        help='In a GitHub Actions job, publish the receipt as a "coldverify receipt" check run bound to the tree')
    verify.add_argument('--require-receipt', action='store_true',
                        help='Exit 0 only when GitHub Actions published a PASS receipt for the tree of HEAD, on the PR head or '
                             'attached to the PR with a "Coldverify-Receipt: <check run URL>" line')
    verify.add_argument('--criteria-check', type=int, metavar='PR',
                        help='On a trusted host, never in CI: derive and link the acceptance criteria for this PR\'s head from its '
                             'strict receipt and print them; with --publish-check, post them as a "coldverify criteria" check run')
    verify.add_argument('--deployed', type=deployed_target, metavar='URL_OR_HOST',
                        help='Run only the flows that read COLD_DEPLOYED_TARGET, once, against this live target, and write the receipt; '
                             'no repro or tests. The flows must only read from the target')
    verify.add_argument('--history', action='store_true',
                        help="Print how often each proof strategy gave each verdict per change type, from this clone's receipt archive")
    verify.add_argument('--base', type=commit_sha, metavar='SHA',
                        help='With --head and --test-command: the commit the test command must fail on (exit 1)')
    verify.add_argument('--head', type=commit_sha, metavar='SHA',
                        help='With --base and --test-command: the checked-out commit the test command must pass on')
    verify.add_argument('--test-command', metavar='COMMAND',
                        help='Untrusted shell command run on --base (with the head\'s changed test files) and on --head, '
                             'in place of the PR repro; runs only in a Coldbox guest or with COLD_VERIFY_BACKEND=local')
    verify.add_argument('--install-command', metavar='COMMAND',
                        help='With --test-command: untrusted shell command run before it in each of the base and head '
                             'worktrees, so each side builds its own dependencies; it gets network, the test does not')
    verify.add_argument('--preview', '--explain-skips', action='store_true', dest='preview',
                        help='Print which tests would run or be skipped, and which filter decided, without running anything')
    return verify


def opted_out(target):
    try:
        report = json.loads((target / '.cold/verify-repro.json').read_text(encoding='utf-8'))
    except (OSError, ValueError):
        return False
    return report.get('result') == 'INCOMPLETE' and bool(report.get('opt_out_reason'))


def dotted(numbers):
    return '.'.join(map(str, numbers))


def path_python():
    python = shutil.which('python3')
    if not python:
        return 'no python3 on PATH', ()
    found = subprocess.run([python, '-c', 'import sys; print(*sys.version_info[:3])'], text=True, capture_output=True)
    return python, tuple(map(int, found.stdout.split())) if found.returncode == 0 else ()


def main(argv=None):
    floor = dotted(PYTHON_FLOOR)
    if sys.version_info < PYTHON_FLOOR:
        print(f'coldverify needs Python {floor} or newer; {sys.executable} is Python {dotted(sys.version_info[:3])}',
              file=sys.stderr, flush=True)
        return 2
    args = parser().parse_args(argv)
    problem = explicit_error(args)
    if problem:
        print(problem, file=sys.stderr, flush=True)
        return 2
    if args.version:
        print(version(), flush=True)
        return 0
    python, found = path_python()
    if found < PYTHON_FLOOR:
        print(f'coldverify needs Python {floor} or newer as python3 on PATH, which runs the verify scripts; '
              f'{python} is Python {dotted(found) or "unknown"}', file=sys.stderr, flush=True)
        return 2
    env = {key: value for key, value in os.environ.items() if key not in GIT_LOCATION}
    top = subprocess.run(['git', 'rev-parse', '--show-toplevel'], text=True, capture_output=True, env=env)
    target = Path(top.stdout.strip()) if top.returncode == 0 else Path.cwd()
    sys.path.insert(0, str(ROOT / 'ci'))
    if args.preview:
        import verify_filter
        return verify_filter.preview(target)
    if top.returncode and not args.compat:
        print(f'COLDVERIFY INCOMPLETE: {target} is not a Git checkout; run coldverify inside a Git repository', flush=True)
        return 2
    if args.deployed and args.require_receipt:
        print('--deployed cannot be combined with --require-receipt: a deployed run proves the target, not the change',
              file=sys.stderr, flush=True)
        return 2
    if args.history:
        import verify_history
        return verify_history.show(target)
    if args.criteria_check:
        import verify_receipt
        return verify_receipt.criteria_check(target, args.criteria_check, list(dict.fromkeys(args.builder_model)), args.publish_check)
    if args.require_receipt:
        import verify_receipt
        result, reason = verify_receipt.require(target)
        print(f'COLDVERIFY RECEIPT {result}: {reason}', flush=True)
        return verify_receipt.CODES.get(result, 1)
    from verify_context import coldbox_guest
    if args.cache and not args.compat and (os.environ.get('GITHUB_ACTIONS') == 'true' or coldbox_guest()):
        print('COLDVERIFY INCOMPLETE: strict --cache is refused in CI while any workflow could forge a trusted receipt; '
              'run without --cache', flush=True)
        return 2
    if args.publish_check and args.compat:
        print('--publish-check needs a strict run; --compat writes no receipt', file=sys.stderr, flush=True)
        return 2
    if args.deployed and (args.compat or args.publish_check):
        print('--deployed cannot be combined with --compat or --publish-check: a deployed run proves the target, not the change',
              file=sys.stderr, flush=True)
        return 2
    skill = ROOT / 'skills/create-verification-skill/SKILL.md'
    print('Proof workflow: read and follow ' + str(skill), flush=True)
    explicit = args.test_command is not None
    if not (args.ci or explicit) and not any(target.glob('.*/skills/verify-*/SKILL.md')):
        print('Missing project verification skill. Run create-verification-skill before coldverify.', flush=True)
        return 2
    import verify_receipt
    import verify_repro_transport
    import verify_trace
    command = ['bash', str(ROOT / 'ci/fleet-verify.sh')]
    pull = pull_error = None
    if not (args.compat or explicit):
        try:
            pull = verify_receipt.pull_request(target)
        except verify_receipt.PullRequestUnknown as error:
            pull_error = str(error)
    claim = (args.claim or (verify_receipt.claim_from(pull[1]) if pull else '')).strip()
    builders = list(dict.fromkeys(args.builder_model))
    declared = verify_receipt.builders_from(pull[1]) if pull else None
    (target / '.cold').mkdir(exist_ok=True)
    (target / '.cold/.gitignore').write_text('*\n')
    import evidence_export
    with (target / '.cold/verify.lock').open('w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        evidence_export.write_marker(target / '.cold', 'coldverify ' + verifier()['version'], evidence_export.CHECKOUT_DAYS)
        verify_receipt.clear(target)
        if args.compat:
            repro = verify_repro_transport.run(target, args.bug_fix, args.no_repro_reason)
            if repro == 2 and not opted_out(target):
                print("FAIL: --compat: ColdStack's verify gate fails a bug fix whose repro is incomplete", file=sys.stderr, flush=True)
            if repro and not (repro == 2 and opted_out(target)):
                return 1
            import verify_fastlane
            lane = verify_fastlane.run(target)
            if lane is not None:
                return lane
            return verify_trace.run(command, target, env=env, gate=args.gate, no_cache=args.no_cache, ci=args.ci, strict=False)
        if explicit:
            import verify_explicit
            checkout = subprocess.run(['git', '-C', str(target), 'rev-parse', 'HEAD'], text=True, capture_output=True, env=env).stdout.strip()
            if checkout != args.head:
                print(f'HEAD is {checkout or "unknown"}, not --head {args.head}; check out --head first', file=sys.stderr, flush=True)
                return 2
            repro = verify_explicit.run(target, args.base, args.head, args.test_command, args.install_command)
            return verify_receipt.finish(target, claim, None, repro, ['coldverify', *sys.argv[1:]], verifier(), None, builders,
                                         claim_source='coldverify --claim')
        withheld = {key: os.environ.pop(key) for key in PUBLISH_TOKENS if args.publish_check and key in os.environ}
        env = {key: value for key, value in env.items() if key not in withheld}
        import verify_flows
        repro = hashes = None
        merge_gate = args.ci and not (args.publish_check or args.deployed) and os.environ.get('GITHUB_ACTIONS') == 'true'
        if args.deployed:
            verify_flows.deployed(target, args.deployed)
        else:
            import verify_fastlane
            failed = merge_gate and verify_fastlane.scans(target)
            if failed:
                return failed
            import verify_history
            verify_history.announce(target)
            repro = verify_repro_transport.run(target, True, args.no_repro_reason, exercised=True)
            hashes = verify_receipt.fingerprint(target, verify_receipt.read(target / verify_receipt.REPRO_PATH), verifier(), env)
            os.environ.update(withheld)
            reused = args.cache and not args.no_cache and verify_receipt.reuse(target, hashes, pull)
            withheld = {key: os.environ.pop(key) for key in withheld}
            if not reused:
                verify_trace.run(command, target, env=env, gate=args.gate, no_cache=args.no_cache or not args.cache, ci=args.ci)
            verify_flows.run(target)
        os.environ.update(withheld)
        source = 'coldverify --claim' if (args.claim or '').strip() else 'pull request'
        code = verify_receipt.finish(target, claim, pull, repro, ['coldverify', *sys.argv[1:]], verifier(), pull_error, builders,
                                     args.publish_check, source, hashes, args.deployed, declared)
        if not merge_gate:
            return code
        return verify_receipt.ci_exit(verify_receipt.read(target / verify_receipt.RECEIPT_JSON),
                                      args.bug_fix or verify_repro_transport.bug_fix(target)[2])


if __name__ == '__main__':
    sys.exit(main())
