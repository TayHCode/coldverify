#!/usr/bin/env python3
import http.server
import json
import os
from functools import partial
from pathlib import Path
import subprocess
import sys
import tempfile
import threading

checkout = Path.cwd()
sys.path.insert(0, str(checkout / 'ci'))
from verify_flows import TARGET


with tempfile.TemporaryDirectory() as folder:
    scratch = Path(folder)
    artifacts = Path(os.environ.get('COLD_FLOW_ARTIFACTS', folder))
    repo = scratch / 'repo'
    subprocess.run(['git', 'init', '-q', str(repo)], check=True)
    flow = repo / '.fleet/flows/feature'
    flow.parent.mkdir(parents=True)
    flow.write_text(f'''#!/usr/bin/env python3
import os
import sys
import urllib.request

with urllib.request.urlopen(os.environ[{TARGET!r}], timeout=10) as response:
    sys.exit(0 if response.read() == b'on' else 1)
''')
    flow.chmod(0o755)
    subprocess.run(['git', 'add', '.'], cwd=repo, check=True)
    subprocess.run(['git', '-c', 'user.name=Flow', '-c', 'user.email=flow@localhost', 'commit', '-qm', 'feature probe'],
                   cwd=repo, check=True)

    site = scratch / 'site'
    site.mkdir()
    handler = partial(http.server.SimpleHTTPRequestHandler, directory=site)
    with http.server.ThreadingHTTPServer(('localhost', 0), handler) as server:
        threading.Thread(target=server.serve_forever, daemon=True).start()
        target = f'http://localhost:{server.server_port}/feature.txt'
        try:
            for content, expected in (('off', (1, 'FAIL', 'regression')), ('on', (0, 'PASS', 'deployed'))):
                (site / 'feature.txt').write_text(content)
                run = subprocess.run([sys.executable, str(checkout / 'coldverify'), '--ci', '--deployed', target,
                                      '--claim', 'feature.txt serves on'], cwd=repo, capture_output=True, text=True)
                (artifacts / f'{content}-output.txt').write_text(run.stdout + run.stderr)
                path = repo / '.cold/verify-receipt.json'
                if not path.is_file():
                    print(f'coldverify wrote no receipt (exit {run.returncode})')
                    sys.exit(2)
                receipt = json.loads(path.read_text())
                (artifacts / f'{content}-receipt.json').write_text(json.dumps(receipt, indent=2))
                flows = receipt['flows']
                actual = (run.returncode, receipt['result'], flows['flows'][0]['kind']) if flows['flows'] else ()
                print(f'{content}: {actual}')
                if actual != expected or flows['contact']['flow_contact'] != 'proven':
                    sys.exit(1)
        finally:
            server.shutdown()
